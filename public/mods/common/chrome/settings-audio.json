{
  "Container": {
    "id": "AUDIO_PANEL",
    "Logic": "AudioSettingsLogic",
    "Width": "PARENT_WIDTH",
    "Height": "PARENT_HEIGHT",
    "Children": {
      "ScrollPanel": {
        "id": "SETTINGS_SCROLLPANEL",
        "Width": "PARENT_WIDTH",
        "Height": "PARENT_HEIGHT",
        "CollapseHiddenChildren": "True",
        "TopBottomSpacing": "5",
        "ItemSpacing": "10",
        "Children": {
          "Background": {
            "id": "AUDIO_SECTION_HEADER",
            "X": "5",
            "Width": "PARENT_WIDTH - 24 - 10",
            "Height": "13",
            "Background": "separator",
            "ClickThrough": "True",
            "Children": {
              "Label": {
                "id": "LABEL",
                "Width": "PARENT_WIDTH",
                "Height": "PARENT_HEIGHT",
                "Font": "TinyBold",
                "Align": "Center",
                "Text": "label-audio-section-header"
              }
            }
          },
          "Container": [
            {
              "id": "ROW",
              "Width": "PARENT_WIDTH - 24",
              "Height": "20",
              "Children": {
                "Container": {
                  "id": "NO_AUDIO_DEVICE_CONTAINER",
                  "X": "10",
                  "Width": "PARENT_WIDTH - 10",
                  "Children": {
                    "Label": {
                      "id": "NO_AUDIO_DEVICE",
                      "Width": "PARENT_WIDTH",
                      "Height": "20",
                      "Align": "Center",
                      "Text": "label-no-audio-device-container"
                    }
                  }
                }
              }
            },
            {
              "id": "ROW",
              "Width": "PARENT_WIDTH - 24",
              "Height": "50",
              "Children": {
                "Container": [
                  {
                    "id": "CASH_TICKS_CONTAINER",
                    "X": "10",
                    "Width": "PARENT_WIDTH / 2 - 20",
                    "Children": {
                      "Checkbox": {
                        "id": "CASH_TICKS",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Font": "Regular",
                        "Text": "checkbox-cash-ticks-container"
                      }
                    }
                  },
                  {
                    "id": "MUTE_SOUND_CONTAINER",
                    "X": "10",
                    "Y": "30",
                    "Width": "PARENT_WIDTH / 2 - 20",
                    "Children": {
                      "Checkbox": {
                        "id": "MUTE_SOUND",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Font": "Regular",
                        "Text": "checkbox-mute-sound-container"
                      }
                    }
                  },
                  {
                    "id": "SOUND_VOLUME_CONTAINER",
                    "X": "PARENT_WIDTH / 2 + 10",
                    "Width": "PARENT_WIDTH / 2 - 20",
                    "Children": {
                      "Label": {
                        "id": "SOUND_LABEL",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Text": "label-sound-volume-container"
                      },
                      "ExponentialSlider": {
                        "id": "SOUND_VOLUME",
                        "Y": "30",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Ticks": "7"
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "ROW",
              "Width": "PARENT_WIDTH - 24",
              "Height": "50",
              "Children": {
                "Container": [
                  {
                    "id": "MUTE_BACKGROUND_MUSIC_CONTAINER",
                    "X": "10",
                    "Width": "PARENT_WIDTH / 2 - 20",
                    "Children": {
                      "Checkbox": {
                        "id": "MUTE_BACKGROUND_MUSIC",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Font": "Regular",
                        "Text": "checkbox-mute-background-music-container.label",
                        "TooltipText": "checkbox-mute-background-music-container.tooltip",
                        "TooltipContainer": "SETTINGS_TOOLTIP_CONTAINER"
                      }
                    }
                  },
                  {
                    "id": "MUSIC_VOLUME_CONTAINER",
                    "X": "PARENT_WIDTH / 2 + 10",
                    "Width": "PARENT_WIDTH / 2 - 20",
                    "Children": {
                      "Label": {
                        "id": "MUSIC_LABEL",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Text": "label-music-title-volume-container"
                      },
                      "ExponentialSlider": {
                        "id": "MUSIC_VOLUME",
                        "Y": "25",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Ticks": "7"
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "ROW",
              "Width": "PARENT_WIDTH - 24",
              "Height": "50",
              "Children": {
                "Container": [
                  {
                    "id": "AUDIO_DEVICE_CONTAINER",
                    "X": "10",
                    "Width": "PARENT_WIDTH / 2 - 20",
                    "Children": {
                      "Label": {
                        "id": "AUDIO_DEVICE_LABEL",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Text": "label-audio-device-container"
                      },
                      "DropDownButton": {
                        "id": "AUDIO_DEVICE",
                        "Y": "25",
                        "Width": "PARENT_WIDTH",
                        "Height": "25"
                      }
                    }
                  },
                  {
                    "id": "VIDEO_VOLUME_CONTAINER",
                    "X": "PARENT_WIDTH / 2 + 10",
                    "Width": "PARENT_WIDTH / 2 - 20",
                    "Children": {
                      "Label": {
                        "id": "VIDEO_LABEL",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Text": "label-video-volume-container"
                      },
                      "ExponentialSlider": {
                        "id": "VIDEO_VOLUME",
                        "Y": "25",
                        "Width": "PARENT_WIDTH",
                        "Height": "20",
                        "Ticks": "7"
                      }
                    }
                  }
                ]
              }
            },
            {
              "id": "ROW",
              "Width": "PARENT_WIDTH - 24",
              "Height": "20",
              "Children": {
                "Container": {
                  "id": "RESTART_REQUIRED_CONTAINER",
                  "X": "10",
                  "Width": "PARENT_WIDTH - 10",
                  "Children": {
                    "Label": {
                      "id": "AUDIO_RESTART_REQUIRED_DESC",
                      "Width": "PARENT_WIDTH",
                      "Height": "20",
                      "Font": "Tiny",
                      "Align": "Center",
                      "Text": "label-restart-required-container-audio-desc"
                    }
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}